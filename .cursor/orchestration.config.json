{
  "version": 1,
  "project": {
    "name": "anxionOS",
    "issuePrefix": "ANX"
  },
  "taskboardProject": "anxionOS",
  "knowledgeRoot": "brain/",
  "codeRoots": ["backend/", "frontend/"],
  "scopeDoc": "SCOPE.md",
  "defaultCTO": "orchestrator",
  "personasFile": ".cursor/orchestration/agent-config/roster.anxionos.json",
  "paths": {
    "runtime": ".cursor/orchestration-runtime",
    "dialogue": ".cursor/orchestration-runtime/dialogue",
    "workflows": ".cursor/orchestration-runtime/workflows",
    "autonomy": ".cursor/orchestration-runtime/autonomy",
    "hire": ".cursor/orchestration-runtime/hire",
    "proactive": ".cursor/orchestration-runtime/proactive",
    "lifecycle": ".cursor/orchestration-runtime/lifecycle",
    "state": ".cursor/orchestration-runtime/state"
  },
  "taskboard": {
    "urlEnv": ["TASKBOARD_URL", "CODEX_TASKBOARD_URL"],
    "defaultUrl": "http://127.0.0.1:47823"
  }
}
