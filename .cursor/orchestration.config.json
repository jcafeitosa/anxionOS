{
  "version": 1,
  "project": {
    "name": "anxionOS",
    "issuePrefix": "ANX"
  },
  "taskboardProject": "anxionOS",
  "knowledgeRoot": "brain/",
  "codeRoots": [
    "backend/",
    "frontend/"
  ],
  "scopeDoc": "SCOPE.md",
  "defaultCTO": "orchestrator",
  "personasFile": ".cursor/orchestration/examples/project-anxionos/roster.anxionos.json",
  "paths": {
    "runtime": ".cursor/orchestration-runtime",
    "dialogue": ".cursor/orchestration-runtime/dialogue",
    "workflows": ".cursor/orchestration-runtime/workflows",
    "autonomy": ".cursor/orchestration-runtime/autonomy",
    "hire": ".cursor/orchestration-runtime/hire",
    "proactive": ".cursor/orchestration-runtime/proactive",
    "lifecycle": ".cursor/orchestration-runtime/lifecycle",
    "state": ".cursor/orchestration-runtime/state"
  },
  "taskboard": {
    "urlEnv": [
      "TASKBOARD_URL",
      "CODEX_TASKBOARD_URL"
    ],
    "defaultUrl": "http://127.0.0.1:47823"
  },
  "taskboardRouting": {
    "project": "dashi",
    "nonProject": "cursor",
    "frameworkIssuePatterns": [
      "^ANX-23[0-9]$",
      "^ANX-240$",
      "^ANX-242$"
    ],
    "frameworkPathPrefixes": [
      ".cursor/orchestration/",
      ".cursor/rules/",
      ".cursor/hooks/",
      ".cursor/skills/",
      ".cursor/commands/",
      ".cursor/orchestration.config.json",
      ".cursor/orchestration-runtime/"
    ],
    "projectPathPrefixes": [
      "backend/",
      "frontend/",
      "docs/",
      "brain/"
    ]
  },
  "llmRouter": {
    "provider": "9router",
    "defaultBaseUrl": "http://localhost:20128/v1",
    "defaultModel": null
  }
}
