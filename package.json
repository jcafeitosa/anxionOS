		"p3:staging-homologation": "bun backend/scripts/p3-staging-homologation.mjs",
		"p4:rebuild-homologation": "bun backend/scripts/p4-rebuild-homologation.mjs",
		"postinstall": "node scripts/ensure-archify.mjs && node scripts/ensure-graphify.mjs",
