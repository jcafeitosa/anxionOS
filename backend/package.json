{
	"name": "@anxionos/backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"modules/*"
	],
	"scripts": {
		"dev": "bun run --filter @anxionos/api dev",
		"build": "bun run --filter '*' build",
		"test": "bun test --max-concurrency=1",
		"test:orchestration": "bun test tests/orchestration --max-concurrency=1",
		"test:graph": "bun test tests/graph/ --max-concurrency=1 --parallel=1",
		"test:boundary": "bun test tests/boundary/ --max-concurrency=1",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --build",
		"boundaries": "depcruise --config .dependency-cruiser.cjs apps packages modules",
		"seed:dev": "bun run --env-file=.env --filter @anxionos/api seed:dev",
		"seed:e2e-institutional": "bun run --filter @anxionos/api seed:e2e-institutional",
		"workers:graph-governance": "bun run --filter @anxionos/workers start"
	},
	"devDependencies": {
		"@anxionos/connections": "workspace:*",
		"@anxionos/contracts": "workspace:*",
		"@anxionos/database": "workspace:*",
		"@anxionos/eventing": "workspace:*",
		"@anxionos/governance": "workspace:*",
		"@anxionos/graph": "workspace:*",
		"@anxionos/identity": "workspace:*",
		"@anxionos/knowledge": "workspace:*",
		"@anxionos/market-data": "workspace:*",
		"@anxionos/observability": "workspace:*",
		"@anxionos/secrets": "workspace:*",
		"@anxionos/orchestration": "workspace:*",
		"@anxionos/organizations": "workspace:*",
		"@anxionos/strategies": "workspace:*",
		"@anxionos/capital": "workspace:*",
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"dependency-cruiser": "^16.10.4",
		"nats": "^2.29.3",
		"neo4j-driver": "6.2.0",
		"typescript": "^5.9.3",
		"@anxionos/accounting": "workspace:*",
		"@anxionos/portfolios": "workspace:*",
		"@anxionos/decisions": "workspace:*",
		"@anxionos/risk": "workspace:*",
		"@anxionos/execution": "workspace:*",
		"@anxionos/billing": "workspace:*",
		"@anxionos/performance": "workspace:*",
		"@anxionos/audit": "workspace:*",
		"@anxionos/evaluation": "workspace:*",
		"@anxionos/operations": "workspace:*",
		"@anxionos/simulation": "workspace:*",
		"@anxionos/partners": "workspace:*",
		"@anxionos/adapter-gateway": "workspace:*",
		"@anxionos/agents": "workspace:*"
	}
}
