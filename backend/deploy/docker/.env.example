# Local Docker sandbox — copy to .env beside docker-compose.yml (never commit real secrets)
POSTGRES_USER=anxionos
POSTGRES_PASSWORD=anxionos
POSTGRES_DB=anxionos
NEO4J_AUTH=neo4j/anxionos
NEO4J_STAGING_PASSWORD=anxionos-staging

# engines-sandbox profile (ANX-162 S3/S4 — quartet + ANX-174 Nautilus)
# SIMULATED: Bun stubs (default). REAL: requires upstream runtime homologation — see ANX-174–180.
ENGINE_MODE=SIMULATED
# S4 service auth — shared between engines and control-plane adapters (dev-only value)
ENGINE_SANDBOX_AUTH_TOKEN=dev-sandbox-auth-local-only
GCT_SANDBOX_PORT=9053
HUMMINGBOT_SANDBOX_PORT=9054
FREQTRADE_SANDBOX_PORT=9055
XCHANGE_SANDBOX_PORT=9056
NAUTILUS_SANDBOX_PORT=9057
CRYPTOFEED_SANDBOX_PORT=9058
MT5_SANDBOX_PORT=9059
