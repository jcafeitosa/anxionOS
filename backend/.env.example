PORT=3000
DATABASE_URL=postgres://anxionos:anxionos@localhost:5432/anxionos
NATS_URL=nats://localhost:4222
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=anxionos
LOG_LEVEL=info

# Identity session revocation (JetStream consumer in API)
IDENTITY_SESSION_CONSUMER_DISABLED=false
NATS_EVENTS_STREAM=EVENTS

# CopilotKit / Intelligence external service (ANX-124, ANX-125)
# Required for CopilotKit/OpenBot backend startup; not used by anxionOS core API today.
# Owner must supply real values via secret store — never commit secrets or mock keys here.
# Source: CopilotKit config.ts (commits 6f332ea / 60d8dac) — brain/research/openbot-comparative-reverse-engineering.md
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
INTELLIGENCE_API_KEY=

# Secrets vault (ANX-129) — dev-only local file vault; never commit vault files
# Blocked when NODE_ENV=production (fail-closed). Use KMS/Vault provider in prod.
ENABLE_DEV_VAULT=false
SECRETS_LOCAL_VAULT_PATH=

# PostgreSQL RLS integration tests (ANX-131)
RUN_PG_INTEGRATION_TESTS=false

# Eventing outbox relay integration tests (ANX-130)
RUN_NATS_INTEGRATION_TESTS=false
DATABASE_ROLE_PASSWORD=change-me-in-production

# Workers outbox relay (ANX-133)
WORKER_PROFILE=outbox-relay
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_LEASE_TTL_MS=30000

# Better Auth (composition root — ANX-134 prep)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:3000
