PORT=3000
DATABASE_URL=postgres://anxionos:anxionos@localhost:5432/anxionos
NATS_URL=nats://localhost:4222
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=anxionos
LOG_LEVEL=info

# Identity session revocation (JetStream consumer in API)
IDENTITY_SESSION_CONSUMER_DISABLED=false
NATS_EVENTS_STREAM=EVENTS

# CopilotKit / Intelligence external service (ANX-124, ANX-125)
# Required for CopilotKit/OpenBot backend startup; not used by anxionOS core API today.
# Owner must supply real values via secret store — never commit secrets or mock keys here.
# Source: CopilotKit config.ts (commits 6f332ea / 60d8dac) — brain/research/openbot-comparative-reverse-engineering.md
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
INTELLIGENCE_API_KEY=

# OpenBot homologation (ANX-144 S1 / R144-06) — fail-closed by default in CI
# SKIP_OPENBOT_E2E=1 (default/unset) skips upstream E2E; set SKIP_OPENBOT_E2E=0 only with INTELLIGENCE_* from secret store
SKIP_OPENBOT_E2E=1

# Secrets vault (ANX-129) — dev-only local file vault; never commit vault files
# Blocked when NODE_ENV=production (fail-closed). Use KMS/Vault provider in prod.
ENABLE_DEV_VAULT=false
SECRETS_LOCAL_VAULT_PATH=

# PostgreSQL RLS integration tests (ANX-131)
RUN_PG_INTEGRATION_TESTS=false

# Eventing outbox relay integration tests (ANX-130)
RUN_NATS_INTEGRATION_TESTS=false
RUN_NEO4J_INTEGRATION_TESTS=false

# Neo4j staging homologation (ANX-292) — graph-staging profile on bolt://localhost:7688
NEO4J_STAGING_URI=bolt://localhost:7688
NEO4J_STAGING_USER=neo4j
NEO4J_STAGING_PASSWORD=anxionos-staging
RUN_NEO4J_STAGING_INTEGRATION_TESTS=false
DATABASE_ROLE_PASSWORD=change-me-in-production

# Workers outbox relay (ANX-133)
WORKER_PROFILE=outbox-relay
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_LEASE_TTL_MS=30000

# Product/Agent Graph projection sandbox (ANX-277) — requires ADR0005 accepted + graph-sandbox profile
ENABLE_PRODUCT_GRAPH_PROJECTION=false
# WORKER_PROFILE=graph-product-projection
# NATS_GRAPH_ORGANIZATIONS_SUBJECT=agency.*.events.organizations.>
# NATS_GRAPH_ORGANIZATIONS_DURABLE=graph-organizations-v1
# NATS_GRAPH_PRODUCT_SUBJECT=events.product.>
# NATS_GRAPH_PRODUCT_DURABLE=graph-product-v1
# NATS_GRAPH_AGENTS_SUBJECT=events.agents.>
# NATS_GRAPH_AGENTS_DURABLE=graph-agents-v1

# Better Auth (composition root — mounts /api/auth/* + GET /v1/auth/post-login-context)
# Required together with DATABASE_URL. Empty secret = Better Auth desligado (rotas 404).
# Gere um valor local (ex.: openssl rand -base64 32). NUNCA commitar o secret real.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:3000

# Dev seed only (ANX-297). Blocked when NODE_ENV=production.
# From backend/:
#   ALLOW_DEV_SEED=true bun run --env-file=.env --filter @anxionos/api seed:dev
# Creates owner/operator/none/multi @anxionos.local — never use in production paths.
ALLOW_DEV_SEED=false
# Optional personal Owner (membership owner of a dedicated seed agency).
# Do not put real passwords in this example file.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Organizations invite token pepper (fail-fast if missing when DATABASE_URL is set)
ORG_INVITE_TOKEN_PEPPER=dev-local-pepper-change-me

# Organizations invite accept rate limit (ANX-243)
# memory = dev/test only; postgres = distributed default when DATABASE_URL is set
ORG_INVITE_ACCEPT_RATE_LIMIT_STORE=postgres

# Trust reverse-proxy headers for client IP (ANX-243 G4)
# false (default): use Bun connection IP via server.requestIP — X-Forwarded-For ignored
# true: use X-Forwarded-For / X-Real-IP (set only behind a trusted load balancer)
TRUST_PROXY=false

# SMTP Gmail STARTTLS (ANX-312). Use a Gmail App Password — not the account password.
# https://support.google.com/accounts/answer/185833
# Fail-closed: empty SMTP_PASS → no sendVerificationEmail; /verify-email stays honest.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Alias aceito: SMTP_PASSWORD (mesmo valor que SMTP_PASS)
