# Organizations invite accept rate limit (ANX-243)
# memory = dev/test only; postgres = distributed default when DATABASE_URL is set
ORG_INVITE_ACCEPT_RATE_LIMIT_STORE=postgres

# Trust reverse-proxy headers for client IP (ANX-243 G4, ANX-491)
# false (default): proxy headers are ignored — the Bun connection IP via
# server.requestIP is used (no socket -> 503 SERVICE_UNAVAILABLE / CLIENT_IP_UNAVAILABLE).
# true: derive the client IP from X-Forwarded-For. Set ONLY behind one or more
# trusted reverse proxies / load balancers.
#
# TRUSTED_PROXY_HOPS — number of trusted proxies between the client and the API
# (each trusted proxy appends exactly one entry to X-Forwarded-For). Default 1,
# matching the documented deployment (a single LB in front). The client IP is
# the TRUSTED_PROXY_HOPS-th entry counted from the RIGHT — the address the first
# trusted proxy observed; everything to its LEFT is ignored because the client
# controls it. Examples (real client 1.2.3.4, forged 9.9.9.9):
#   TRUSTED_PROXY_HOPS=1, X-Forwarded-For "1.2.3.4"                 -> 1.2.3.4
#   TRUSTED_PROXY_HOPS=1, X-Forwarded-For "9.9.9.9, 1.2.3.4"        -> 1.2.3.4
#   TRUSTED_PROXY_HOPS=2, X-Forwarded-For "9.9.9.9, 1.2.3.4, 10.0.0.1" -> 1.2.3.4
# Undercounting is safe (the key becomes a proxy address = stricter shared
# bucket); OVERCOUNTING makes the API trust a client-supplied value — never set
# it above the real proxy chain. 0 disables header trust (connection IP only).
# The proxy MUST append to or overwrite X-Forwarded-For — "there is a load
# balancer" alone is not enough: nginx proxy_add_x_forwarded_for appends (safe
# with the hop count above); forwarding $http_x_forwarded_for verbatim without
# appending is NOT safe. X-Real-IP is no longer trusted (ANX-491): it has no
# hop structure, so the client could rotate it whenever the proxy does not
# overwrite it.
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1

# SMTP Gmail STARTTLS (ANX-312). Use a Gmail App Password — not the account password.
# https://support.google.com/accounts/answer/185833
# Fail-closed: empty SMTP_PASS → no sendVerificationEmail; /verify-email stays honest.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Alias aceito: SMTP_PASSWORD (mesmo valor que SMTP_PASS)

# ANX-170 — eventing lag SLI ticker (platform SLO S2)
EVENTING_LAG_SLI_DISABLED=false
# Poll interval in ms (minimum 1000)
EVENTING_LAG_SLI_INTERVAL_MS=30000

