# Dashi / Codex Taskboard (dev local only — not used in CI)
# UI: http://127.0.0.1:47823/
TASKBOARD_URL=http://127.0.0.1:47823
# CODEX_TASKBOARD_URL=http://127.0.0.1:47823

# Project name on the board (default: anxionOS)
TASKBOARD_PROJECT_NAME=anxionOS

# Optional: pin project when multiple boards share the same name (from npm run taskboard:context)
TASKBOARD_PROJECT_ID=temp-5662cec5-cef8-4e48-a3cb-055e1c8076c5

# Required for taskctl writes (create, move, comment). Set by the agent runtime when available.
# CODEX_THREAD_ID=
# CLAUDE_CODE_SESSION_ID=
# CURSOR_THREAD_ID=
# TASKBOARD_CLIENT=cursor

# Graphify (local knowledge graph index — not used in CI secrets)
GRAPHIFY_OUT=.graphify/out

# Frontend + API local (valores reais ficam em backend/.env — nunca commitar secrets)
# BETTER_AUTH_SECRET / BETTER_AUTH_URL: ver backend/.env.example
# Sem BETTER_AUTH_SECRET a API sobe, mas GET /v1/auth/post-login-context e /api/auth/* retornam 404.

# 9Router — gateway OpenAI-compatible local (ANX-254, framework orchestration)
# Install: npm install -g 9router · Dashboard: http://localhost:20128/dashboard
# Docs: .cursor/orchestration/9ROUTER-INTEGRATION.md
NINEROUTER_BASE_URL=http://localhost:20128/v1
# Alias usado por Cursor, graphify e SDKs OpenAI-compat:
OPENAI_BASE_URL=http://localhost:20128/v1
# Copiar do dashboard 9Router — NUNCA commitar valor real
OPENAI_API_KEY=
# Modelo com prefixo de provider (ex.: kr/claude-sonnet-4.5, cc/claude-opus-4-7)
NINEROUTER_MODEL=
