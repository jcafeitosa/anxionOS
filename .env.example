# Dashi / Codex Taskboard (dev local only — not used in CI)
# UI: http://127.0.0.1:47823/
TASKBOARD_URL=http://127.0.0.1:47823
# CODEX_TASKBOARD_URL=http://127.0.0.1:47823

# Project name on the board (default: anxionOS)
TASKBOARD_PROJECT_NAME=anxionOS

# Optional: pin project when multiple boards share the same name (from npm run taskboard:context)
TASKBOARD_PROJECT_ID=temp-5662cec5-cef8-4e48-a3cb-055e1c8076c5

# Required for taskctl writes (create, move, comment). Set by the agent runtime when available.
# CODEX_THREAD_ID=
# CLAUDE_CODE_SESSION_ID=
# CURSOR_THREAD_ID=

# Graphify (local knowledge graph index — not used in CI secrets)
GRAPHIFY_OUT=.graphify/out
